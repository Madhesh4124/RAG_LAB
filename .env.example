# ============================================================================
# RAG Lab Environment Variables - Example Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit real secrets to version control
# ============================================================================

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
AUTH_SECRET_KEY=generate-a-secure-random-string-at-least-32-chars
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ============================================================================
# STORAGE (HF Space Bucket mounted at /data)
# ============================================================================
DATABASE_URL=sqlite:////data/rag_lab.db
CHROMA_PERSIST_DIR=/data/chroma_data
UPLOAD_DIR=/data/uploads

# Local Postgres compose defaults (used by docker-compose.yml)
POSTGRES_DB=raglab
POSTGRES_USER=raglab
POSTGRES_PASSWORD=change-me

# ============================================================================
# LLM, EMBEDDING & RERANKER PROVIDERS
# ============================================================================
# Primary LLM provider: nvidia (Nemotron 3.5 30B) or gemini (2.5 Flash)
DEFAULT_LLM_PROVIDER=nvidia
DEFAULT_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=nvapi-...your-nvidia-api-key # Powers Nemotron LLM generation, embeddings, & nemotron-3.5-rerank-8b

# Fast LLM-as-a-judge evaluation & fallback generation
GROQ_API_KEY=gsk_...your-groq-api-key
EVALUATION_LLM_PROVIDER=groq
EVALUATION_LLM_MODEL=openai/gpt-oss-120b

# Google Gemini provider (embeddings & fallback generation)
GOOGLE_API_KEY=AIza...your-google-api-key
GEMINI_API_KEY=AIza...your-google-api-key

# Embedding defaults
DEFAULT_EMBEDDING_PROVIDER=nvidia
DEFAULT_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
HUGGINGFACE_API_KEY=hf_...your-huggingface-token # Optional: for gated model downloads

# Optional local CLIP image indexing for embedded PDF images.
# First run downloads the Hugging Face model unless already cached.
PDF_IMAGE_INDEXING_ENABLED=false
HF_IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
# Alternative higher-quality multimodal model (heavier):
# HF_IMAGE_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
PDF_IMAGE_MIN_WIDTH=64
PDF_IMAGE_MIN_HEIGHT=64

# ============================================================================
# RATE LIMITING (Per-User, Per-Hour)
# ============================================================================
MAX_LLM_CALLS_PER_HOUR=15
MAX_EMBEDDING_CALLS_PER_HOUR=50
MAX_RETRIEVAL_CALLS_PER_HOUR=100

# ============================================================================
# EMAIL & PASSWORD RESET (Brevo HTTPS REST API or SMTP fallback)
# ============================================================================
BREVO_API_KEY=xkeysib-...your-brevo-api-key
BREVO_SENDER_EMAIL=madhesh4124@gmail.com
BREVO_SENDER_NAME="RAG Lab"
# Optional SMTP fallback (for local development only):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SENDER_EMAIL=your-email@gmail.com
# SMTP_SENDER_PASSWORD=your-google-app-password

# ============================================================================
# TELEMETRY (Local Development)
# ============================================================================
ANONYMIZED_TELEMETRY=FALSE
